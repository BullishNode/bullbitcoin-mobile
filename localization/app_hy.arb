  "lightningAddressDeactivated": "Lightning Address-ը անջատված է",
  "lightningAddressLoading": "Ստեղծում ենք ձեր Nostr ինքնությունը",
  "lightningAddressCreating": "Ձեր nym-ը ստեղծվում է",
  "lightningAddressCreatingDesc": "Գրանցում ենք ձեր Lightning Address-ը...",
  "lightningAddressAutoSweep": "Ավտոմատ փոխանցում Instant Payments",
  "lightningAddressAutoSweepSub": "Ավտոմատ տեղափոխել ստացված միջոցները գաղտնիության համար",
  "lightningAddressAutoSweepInfo": "Ձեր Lightning Address-ի միջոցով ստացված բոլոր միջոցներն ավտոմատ ուղարկվում են ձեր Instant Payments դրամապանակ։\n\nԻնչու՞: Lightning Address-ի սերվերը գիտի ձեր Lightning Address դրամապանակի հանրային բանալին (xpub), այսինքն կարող է տեսնել այդ դրամապանակի բոլոր գործարքները։ Փոխանցումը Instant Payments դրամապանակ պաշտպանում է ձեր գաղտնիությունը։\n\nԹերությունը՝ յուրաքանչյուր փոխանցման ժամանակ վճարում եք փոքր Liquid Network վճար (~20 sats):",
  "lightningAddressHideWallet": "Թաքցնել դրամապանակը գլխավոր էկրանին",
  "lightningAddressHideWalletSub": "Պահեք գլխավոր էկրանը մաքուր",
  "lightningAddressHideWalletInfo": "Lightning Address դրամապանակը հատուկ դրամապանակ է, որն օգտագործվում է միայն Lightning Address վճարումներ ստանալու համար։ Այն թաքցնելը գլխավոր էկրանը մաքուր է պահում — միջոցներն ամեն դեպքում ավտոմատ փոխանցվում են ձեր Instant Payments դրամապանակ։\n\nԴուք միշտ կարող եք գտնել այս դրամապանակը Կարգավորումներ > Դրամապանակներ բաժնում։",
  "lightningAddressDeactivateTitle": "Անջատել Lightning Address-ը?",
  "lightningAddressDeactivateBody": "Մարդիկ այլևս չեն կարող միջոցներ ուղարկել {address} հասցեին, մինչև որ չվերակտիվացնեք։ Ոչ ոք չի կարող գրավել այս հասցեն — այն մնում է վերապահված ձեզ համար։",
  "lightningAddressDeactivateCancel": "Չեղարկել",
  "lightningAddressDeactivateConfirm": "Անջատել",
  "lightningAddressTapToCopy": "Հպեք պատճենելու համար",
  "lightningAddressPreviousFound": "Գտնվել է նախկին հասցե",
