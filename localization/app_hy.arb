  "lightningAddressTitle": "Lightning Address",
  "lightningAddressActive": "Ձեր Lightning Address-ը ակտիվ է",
  "lightningAddressChooseNym": "Ընտրեք ձեր nym-ը",
  "lightningAddressNymHint": "satoshi",
  "lightningAddressRegister": "Գրանցել",
  "lightningAddressCopied": "Պատճենվել է փոխանակման մեջ",
  "lightningAddressHowItWorksLink": "Ինչպես է աշխատում՝ վճարներ և անվտանգություն",
  "lightningAddressHowItWorksTitle": "Ինչպես է աշխատում",
  "lightningAddressHowItWorksBody": "Lightning Address-ի հետ համատեղելի ցանկացած դրամապանակ կարող է միջոցներ ուղարկել այս Lightning Address-ին։ Ստացած վճարումները ավտոմատ կփոխանակվեն Liquid Network-ում (L-BTC)։ Եթե միացված է Instant Payments դրամապանակ ավտոմատ փոխանցումը (լռելյայն միացված է), միջոցները կհայտնվեն ձեր սովորական Instant Payments դրամապանակում։",
  "lightningAddressSecurityTitle": "Անվտանգություն",
  "lightningAddressSecurityBody1": "Որպեսզի սա աշխատի՝ Bull Bitcoin-ն օգտագործում է հատուկ սերվեր, որը ստեղծում է atomic swap ուղարկողի Lightning Network վճարման և ձեր Liquid Network հասցեի միջև։",
  "lightningAddressSecurityBold": "Այս համակարգը trustless չէ։",
  "lightningAddressSecurityBody2": "Տեխնիկապես սերվերը կարող է միջոցները վերահղել այլ հասցեի և գողանալ մուտքային վճարումները։ Դուք պետք է վստահեք, որ Bull Bitcoin-ի nym սերվերի օպերատորները գործում են ազնվորեն։",
  "lightningAddressFeesTitle": "Վճարներ",
  "lightningAddressFeesBody": "Boltz փոխանակման ծառայությունը գանձում է 0.25% փոխանակման վճար, իսկ ցանցային վճարները հանվում են ձեր ստացած գումարից (սովորաբար 40 sats)։ Եթե ակտիվ է ավտոմատ փոխանցումը, դուք կվճարեք ևս ~20 sats։",
  "lightningAddressPrivacyTitle": "Գաղտնիություն",
  "lightningAddressPrivacyBody": "Այս ծառայությունն օգտագործելիս դուք բեռնում եք ձեր Liquid Network descriptor-ը (xpub-ի նման) Bull Bitcoin-ի nym սերվերի օպերատորին։ Այնուամենայնիվ, Bull Bitcoin-ի դրամապանակը ավտոմատ ստեղծում է այս նպատակով հատուկ դրամապանակ, որը տարբերվում է ձեր լռելյայն Instant Payments դրամապանակից։ Այսպիսով, թեև սերվերը որոշ տեսանելիություն ունի, այն չի կարող ապաանանուն դարձնել ձեր հիմնական Instant Payments դրամապանակը։ Սերվերը չի հավաքում ձեր մասին որևէ տեղեկություն՝ ոչ IP հասցե, ոչ KYC տեղեկություն։ Ծառայությունը լիովին անանուն է։",
  "lightningAddressDelete": "Անջատել Lightning Address-ը",
